{
  "package": "Team_Intelligence_Center",
  "version": "0.5.3",
  "package_id": "Team_Intelligence_Center_0.5.3",
  "type": "lightweight_rules_automation",
  "release_status": "public_preview",
  "license": "Apache-2.0",
  "purpose": "Install a small, tool-neutral collaboration entrypoint and independently selectable capabilities into software projects.",
  "automation_policy": {
    "principle": "outcome first, native execution by default, protect only concrete actions, require evidence for claims",
    "workflow_core": "Workflow/core.md",
    "workflow_model": "native_outcome_driven_five_dimensions",
    "decision_dimensions": [
      "planning_depth",
      "execution_authority",
      "verification_scope",
      "review_level",
      "fact_persistence"
    ],
    "skill_contract_schema": "tic_capability.v1",
    "capability_selection": "activate_only_for_explicit_request_or_exact_activation_facts; apply_not_when_before_keywords; never_auto_chain_related_capabilities",
    "wrapper_trigger_policy": "descriptions_mirror_exact_activation_facts_and_never_encode_before_after_workflow_order",
    "orchestrator_policy": "explicit_planning_and_compatibility_only",
    "checkpoint_policy": "pause_only_for_user_decisions_or_confirmation_required_actions",
    "artifact_policy": "consumer_driven",
    "verification_policy": "continuous_evidence_line_with_fresh_final_verification_proportional_to_the_claim",
    "review_policy": "self_diff_review_by_default; independent_or_user_review_only_when_triggered_by_contract_impact_uncertainty_or_protected_action",
    "planning_policy": "inline_by_default; brief_for_alignment; living_for_long_running_multi_milestone_or_greenfield_product_work",
    "product_baseline_policy": "greenfield_products_and_major_user_journeys_require_owner_confirmed_users_outcome_scope_non_goals_primary_journey_and_acceptance_before_durable_implementation",
    "product_spike_policy": "before_product_baseline_confirmation_allow_only_discovery_prototypes_and_reversible_technical_spikes_that_do_not_freeze_product_behavior",
    "ui_baseline_policy": "user_visible_products_define_roles_primary_journey_information_architecture_and_key_states_before_durable_contracts_and_implementation",
    "authority_policy": "autonomous_for_authorized_local_reversible_work; confirmation_required_for_external_irreversible_or_high_consequence_actions",
    "openspec_integration": "optional_specification_carrier_when_behavior_needs_a_durable_contract",
    "task_context_has_no_mandatory_artifacts": true,
    "single_primary_fact_source": true,
    "external_method_skills": "optional_fact_triggered_method_library",
    "umbrella_workflow_skills_are_not_default_entrypoints": true,
    "skills_reference_only_by_default": true,
    "auto_project_profile": true,
    "project_adapter_lifecycle": "preserve_existing_project_facts_by_default; create_enrich_audit_migrate_repair_via_project_adapter_maintainer",
    "artifact_ownership": "project_adapter_declares_owner_and_roots_for_sdd_tdd_evidence_prd_walkthrough_release_registry_and_shared_memory",
    "delivery_walkthrough": "generate_only_when_an_identified_consumer_needs_asynchronous_review_qa_ui_or_usage_handoff",
    "prd_authoring": "create_or_confirm_a_product_baseline_for_greenfield_products_major_user_journeys_or_explicit_prd_requests; keep_draft_until_owner_confirmation",
    "prd_review": "review_product_baseline_readiness_and_destructive_scope_drift_without_approving_implementation_or_release",
    "post_dev_prd_sync": "sync_only_preapproved_delivered_behavior; report_unapproved_spec_drift_without_rewriting_product_intent",
    "memory_policy": "explicit_or_confirmed_reuse_only",
    "collaboration_memory_lifecycle": "explicit_or_confirmed_reuse_only; extract_review_promote_reconcile_audit_deprecate_with_consent_evidence_scope_sensitivity_expiry_and_conflict_controls",
    "collaboration_memory_retrieval": "never_default_task_context; retrieve_only_relevant_confirmed_unexpired_items_after_explicit_or_project_confirmed_activation",
    "collaboration_memory_storage": "shared_project_assets_in_ai_harness_memory; personal_preferences_and_private_candidates_in_gitignored_tic_local",
    "e2e_verification": "activate_when_local_checks_cannot_prove_an_important_user_journey_cross_layer_flow_or_high_consequence_behavior",
    "e2e_provider_policy": "prefer_project_native_repeatable_suites; playwright_test_is_default_web_candidate; mcp_browser_chrome_computer_use_are_replaceable_exploration_debug_or_observable_evidence_adapters",
    "e2e_adapter_schema": "project_adapter_declares_policy_runner_environment_auth_data_cleanup_core_journeys_and_evidence_root_without_secrets",
    "ui_visual_verification": "use_playwright_browser_screenshots_computer_use_or_chrome_when_ui_claims_require_real_interface_checks",
    "ui_design_skill_routing": "use_available_design_and_ui_ux_capabilities_for_ui_changes_and_real_interface_tools_for_verification",
    "agent_session_protocol": "use_native_host_threads_for_same_task_subagents; use_human_readable_agent_run_artifacts_only_for_cross_task_cross_tool_long_running_or_audited_sessions",
    "codegraph_optional": true,
    "project_tool_rule_entries": true,
    "codex_global_loader": "optional_global_loader_and_tic_capability_wrappers_only",
    "one_command_user_update": "select_stable_current_or_explicit_ref_then_refresh_rules_source_codex_global_wrappers_and_project_entrypoint_while_preserving_existing_project_adapter_and_memory",
    "update_channels": [
      "stable",
      "current",
      "explicit_ref"
    ],
    "stable_update_policy": "highest_semver_release_tag",
    "default_version_format": "semver",
    "default_tag_policy": "preserve-existing",
    "git_write_policy": "no_write_without_explicit_authorization; execute_when_the_requested_result_is_authorized_and_safely_resolved",
    "git_branch_creation_remote_freshness_gate": "require authoritative_remote_fetch_prune_tags, base_branch_sync_check, and local_remote_same_name_branch_check before branch creation",
    "git_authorization_policy": "reuse_explicit_current_task_authorization_when_remote_refs_version_and_impact_resolve_uniquely; reask_only_for_ambiguity_or_scope_expansion",
    "git_advice_reports_remote_freshness_gap": true,
    "git_advice_resolves_project_declared_branch_bases": true,
    "no_git_hooks_by_default": true,
    "no_vendor_assets": true,
    "no_codex_only_constraint": true,
    "release_archive_root": "docs/releases",
    "previous_version_archive": "docs/releases/0.5.2"
  },
