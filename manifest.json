{
  "package": "Team_Intelligence_Center",
  "version": "0.3.0",
  "package_id": "Team_Intelligence_Center_0.3.0",
  "type": "lightweight_rules_automation",
  "release_status": "public_preview",
  "license": "Apache-2.0",
  "purpose": "Install a small, tool-neutral AI collaboration rules entrypoint into business projects.",
  "automation_policy": {
    "default_install_mode": "minimal",
    "tool_neutral": true,
    "principle": "adaptive workflow + specification-driven delivery + acceptance-driven verification + risk-based E2E gate",
    "mainline_policy": "TIC routes risk, action-based checkpoints, conditional E2E verification, evidence, and closeout; OpenSpec remains the specification source of truth; execution methods remain replaceable; tests or observable verification derive from acceptance criteria",
    "workflow_orchestrator": "Skills/tic-workflow-orchestrator.md",
    "workflow_model": "single_adaptive_with_risk_floor",
    "risk_floor": "none",
    "strict_mode_alias": "risk_floor=critical",
    "skill_contract_schema": "tic_skill.v1",
    "openspec_integration": "optional_spec_carrier_for_standard_and_critical_changes",
    "auto_project_profile": true,
    "codegraph_optional": true,
    "delivery_walkthrough": "generate_evidence_based_walkthrough_artifact_after_standard_or_critical_implementation_when_review_qa_ui_or_usage_handoff_is_needed",
    "post_dev_prd_sync": "generate_evidence_based_prd_update_draft_after_standard_or_critical_delivery_when_product_behavior_changes",
    "one_command_user_update": "select_stable_current_or_explicit_ref_then_refresh_rules_source_codex_global_wrappers_and_project_entrypoint_while_preserving_existing_project_adapter",
    "project_adapter_lifecycle": "preserve_existing_project_facts_by_default; create_enrich_audit_migrate_repair_via_project_adapter_maintainer",
    "e2e_verification": "conditionally_route_standard_and_critical_changes_to_a_tool_neutral_verification_gate_derived_from_acceptance_criteria",
    "e2e_provider_policy": "prefer_project_native_repeatable_suites; playwright_test_is_default_web_candidate; mcp_browser_chrome_computer_use_are_replaceable_exploration_debug_or_observable_evidence_adapters",
    "e2e_adapter_schema": "project_adapter_declares_policy_runner_environment_auth_data_cleanup_core_journeys_and_evidence_root_without_secrets",
    "update_channels": [
      "stable",
      "current",
      "explicit_ref"
    ],
    "stable_update_policy": "highest_semver_release_tag",
    "default_version_format": "semver",
    "default_tag_policy": "preserve-existing",
    "checkpoint_policy": "pause_on_material_decision_external_side_effect_irreversible_action_release_or_scope_expansion",
    "skills_reference_only_by_default": true,
    "codex_global_loader": "optional_global_loader_and_tic_skill_wrappers_only",
    "ui_visual_verification": "use_playwright_browser_screenshots_computer_use_or_chrome_when_ui_risk_requires_real_interface_checks",
    "ui_design_skill_routing": "use_design_taste_frontend_and_ui_ux_pro_max_for_ui_changes_and_computer_use_for_end_to_end_real_interface_validation",
    "agent_session_protocol": "use_native_host_threads_for_same-task_subagents; use_human_readable_agent_run_artifacts_for_cross-task_cross-tool_long-running_or_audited_sessions; session_id_is_trace_only_not_source_of_truth",
    "artifact_ownership": "project_adapter_declares_owner_and_roots_for_sdd_tdd_evidence_prd_walkthrough_and_release_registry",
    "risk_routing": [
      "consulting",
      "micro",
      "standard",
      "critical"
    ],
    "closeout_phase": "route delivery walkthrough, PRD sync, changelog, and release handoff by risk and user-visible impact",
    "no_vendor_assets": true,
    "no_git_hooks_by_default": true,
    "git_workflow_advice_only": true,
    "git_branch_creation_remote_freshness_gate": "require git_fetch_all_prune_tags, base_branch_sync_check, and local_remote_same_name_branch_check before feature_release_hotfix_branch_creation",
    "git_advice_reports_remote_freshness_gap": true,
    "git_advice_resolves_project_declared_branch_bases": true,
    "no_forced_full_flow_for_readonly_or_micro_tasks": true,
    "specification_and_verification_required_for_standard_and_critical": true,
    "sdd_tdd_as_workflow_semantics": true,
    "project_tool_rule_entries": true,
    "no_codex_only_constraint": true,
    "release_archive_root": "docs/releases",
    "previous_version_archive": "docs/releases/0.2.2"
  },
  "skill_lifecycle": {
    "canonical": [
      "tic-workflow-orchestrator",
      "task-decomposer",
      "code-investigator",
      "contract-handoff",
      "shared-domain-arbiter",
      "agent-session-protocol",
      "e2e-verification",
      "delivery-walkthrough",
      "release-handoff",
      "post-dev-prd-sync",
      "changelog-writer",
      "git-flow-operator",
      "project-governance-bootstrap",
      "project-adapter-maintainer"
    ],
    "aliases": {
      "api-contract-freezer": "contract-handoff",
      "fe-be-handoff": "contract-handoff",
      "conflict-arbiter": "shared-domain-arbiter",
      "release-ops-handoff": "release-handoff",
      "release-train-handoff": "release-handoff"
    },
    "subflows": {
      "candidate-rule-extractor": "code-investigator",
      "prd-review-checklist": "task-decomposer",
      "session-snapshot-manager": "tic-workflow-orchestrator"
    },
    "compatibility_policy": "aliases and subflows remain available for at least one major adoption cycle before physical removal"
  },
  "source_assets": {
    "changelog": "CHANGELOG.md",
    "release_archive_dir": "docs/releases",
    "sdd_dir": "docs/sdd",
    "test_evidence_dir": "docs/test-evidence",
    "global_rules": [
      "Global-Rules/coding-rules.md"
    ],
    "prompts": [
      "Prompts/ai-prd-generator.rules.md",
      "Prompts/ai-prd-editor.rules.md"
    ],
    "skills_dir": "Skills",
    "design_dir": "Design"
  },
  "templates": [
    "templates/AGENTS.md",
    "templates/docs/ai-rules-usage.md",
    "templates/ai-harness/project-adapter.md",
    "templates/ai-harness/agent-session-protocol.md",
    "templates/tool-rules/cursorrules.md",
    "templates/tool-rules/windsurfrules.md",
    "templates/tool-rules/rules/team-intelligence-center.md",
    "templates/codex-global/AGENTS.md"
  ],
  "tools": [
    "tools/bootstrap-project.ps1",
    "tools/bootstrap-project.sh",
    "tools/codegraph-helper.ps1",
    "tools/codegraph-helper.sh",
    "tools/git-advice.ps1",
    "tools/git-advice.sh",
    "tools/install.ps1",
    "tools/install.sh",
    "tools/update.ps1",
    "tools/update.sh",
    "tools/install-codex-global.ps1",
    "tools/install-codex-global.sh",
    "tools/validate-pack.sh"
  ],
  "generated_project_files": [
    "AGENTS.md",
    ".tic-rules.lock",
    "docs/ai-rules-usage.md",
    ".cursorrules",
    ".windsurfrules",
    ".rules/team-intelligence-center.md",
    "ai-harness/project-adapter.md",
    "ai-harness/agent-session-protocol.md"
  ],
  "generated_local_files": [
    ".tic-rules.local",
    ".tic-backups/"
  ],
  "borrowed_from_codex_project": [
    "manifest based versioning",
    "idempotent project bootstrap",
    "marker bounded AGENTS merge",
    "dry-run first installation",
    "minimal lock file for diagnostics",
    "local-only rules source resolver to avoid committed machine paths",
    "evidence-based project adapter scaffold with preservation-first lifecycle",
    "optional CodeGraph helper for context and impact analysis",
    "UI visual verification rule for real interface checks",
    "artifact-style delivery walkthrough with summary, evidence, review guidance, media references, risks, and follow-up actions",
    "evidence-based post-development PRD sync draft",
    "one-command install wrapper",
    "project-level tool rule entries that point back to AGENTS.md",
    "optional Codex global loader and tic-* skill wrappers",
    "risk based task routing",
    "single adaptive workflow with risk_floor",
    "machine-readable TIC skill contracts",
    "human-readable agent session artifacts for controlled multi-agent fan-out",
    "risk-based tool-neutral E2E verification gate with project-native runner preference"
  ],
  "intentionally_excluded": [
    "Codex-only workflow binding",
    "full/patch distribution complexity",
    "vendored binaries",
    "default Git hooks",
    "automatic Git branch/commit/push/merge/tag execution",
    "mandatory CodeGraph installation or initialization",
    "mandatory full end-to-end browser flow for every UI micro task",
    "mandatory Playwright, MCP, Browser, Chrome, or Computer Use dependency",
    "automatic copy of Skills into project-local or global skill directories",
    "full project rules in Codex global AGENTS",
    "RTK requirement",
    "project PRD history packaging",
    "forced SDD/Plan/Approval for readonly and micro tasks",
    "branch lifecycle automation",
    "standalone SDD/TDD skill chain that bypasses OpenSpec or Superpowers",
    "free-form cross-session agent group chat without orchestrator-owned artifacts"
  ]
}
