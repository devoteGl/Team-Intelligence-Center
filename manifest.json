{
  "package": "Team_Intelligence_Center",
  "version": "0.1.0",
  "package_id": "Team_Intelligence_Center_0.1.0",
  "type": "lightweight_rules_automation",
  "purpose": "Install a small, tool-neutral AI collaboration rules entrypoint into business projects.",
  "automation_policy": {
    "default_install_mode": "minimal",
    "tool_neutral": true,
    "principle": "SDD + TDD",
    "openspec_integration": "optional_spec_carrier_for_standard_and_critical_changes",
    "auto_project_profile": true,
    "codegraph_optional": true,
    "delivery_walkthrough": "generate_evidence_based_walkthrough_artifact_after_standard_or_critical_implementation_when_review_qa_ui_or_usage_handoff_is_needed",
    "post_dev_prd_sync": "generate_evidence_based_prd_update_draft_after_standard_or_critical_delivery_when_product_behavior_changes",
    "skills_reference_only_by_default": true,
    "codex_global_loader": "optional_global_loader_and_tic_skill_wrappers_only",
    "ui_visual_verification": "use_playwright_browser_screenshots_computer_use_or_chrome_when_ui_risk_requires_real_interface_checks",
    "risk_routing": [
      "consulting",
      "micro",
      "standard",
      "critical"
    ],
    "no_vendor_assets": true,
    "no_git_hooks_by_default": true,
    "git_workflow_advice_only": true,
    "no_forced_full_flow_for_readonly_or_micro_tasks": true,
    "sdd_tdd_required_for_standard_and_critical": true,
    "no_codex_only_constraint": true
  },
  "source_assets": {
    "global_rules": [
      "Global-Rules/coding-rules.md"
    ],
    "prompts": [
      "Prompts/ai-prd-generator.rules.md",
      "Prompts/ai-prd-editor.rules.md"
    ],
    "skills_dir": "Skills",
    "design_dir": "Design"
  },
  "templates": [
    "templates/AGENTS.md",
    "templates/docs/ai-rules-usage.md",
    "templates/ai-harness/project-adapter.md",
    "templates/codex-global/AGENTS.md"
  ],
  "tools": [
    "tools/bootstrap-project.ps1",
    "tools/bootstrap-project.sh",
    "tools/codegraph-helper.ps1",
    "tools/codegraph-helper.sh",
    "tools/git-advice.ps1",
    "tools/git-advice.sh",
    "tools/install.ps1",
    "tools/install.sh",
    "tools/install-codex-global.ps1",
    "tools/install-codex-global.sh",
    "tools/validate-pack.sh"
  ],
  "generated_project_files": [
    "AGENTS.md",
    ".tic-rules.lock",
    "docs/ai-rules-usage.md",
    "ai-harness/project-adapter.md"
  ],
  "generated_local_files": [
    ".tic-rules.local",
    ".tic-backups/"
  ],
  "borrowed_from_codex_project": [
    "manifest based versioning",
    "idempotent project bootstrap",
    "marker bounded AGENTS merge",
    "dry-run first installation",
    "minimal lock file for diagnostics",
    "local-only rules source resolver to avoid committed machine paths",
    "auto-generated project adapter",
    "optional CodeGraph helper for context and impact analysis",
    "UI visual verification rule for real interface checks",
    "artifact-style delivery walkthrough with summary, evidence, review guidance, media references, risks, and follow-up actions",
    "evidence-based post-development PRD sync draft",
    "one-command install wrapper",
    "optional Codex global loader and tic-* skill wrappers",
    "risk based task routing"
  ],
  "intentionally_excluded": [
    "Codex-only workflow binding",
    "full/patch distribution complexity",
    "vendored binaries",
    "default Git hooks",
    "automatic Git branch/commit/push/merge/tag execution",
    "mandatory CodeGraph installation or initialization",
    "mandatory full end-to-end browser flow for every UI micro task",
    "automatic copy of Skills into project-local or global skill directories",
    "full project rules in Codex global AGENTS",
    "RTK requirement",
    "project PRD history packaging",
    "forced SDD/Plan/Approval for readonly and micro tasks",
    "branch lifecycle automation"
  ]
}
